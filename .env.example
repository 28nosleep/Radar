F117_DATABASE_URL=postgresql+asyncpg://f117:f117@postgres:5432/f117
F117_RSS_CATALOG_PATH=config/feeds.json
F117_SCHEDULER_INTERVAL_MINUTES=180
F117_CANDIDATE_LOOKBACK_HOURS=24
F117_FRESHNESS_DAILY_MAX_AGE_DAYS=30
F117_FRESHNESS_YOUTUBE_DAILY_MAX_AGE_DAYS=30
F117_FRESHNESS_FUNNY_WTF_MAX_AGE_DAYS=14
F117_FRESHNESS_DISCOVERY_MAX_AGE_DAYS=14
F117_DEDUP_LOOKBACK_DAYS=7
F117_DEDUP_TITLE_THRESHOLD=0.92
F117_DIGEST_TOP_N=10
F117_RSS_MAX_CONCURRENCY=8
F117_METADATA_FETCH_MAX_RESPONSE_BYTES=300000
F117_METADATA_FETCH_TIMEOUT_SECONDS=8
F117_TELEGRAM_FORMAT=editorial
F117_GITHUB_API_TOKEN=
F117_REDDIT_CLIENT_ID=
F117_REDDIT_CLIENT_SECRET=
F117_YOUTUBE_API_KEY=

# Explainable rule-based score weights (relative values; defaults sum to 100).
F117_RANK_FRESHNESS_WEIGHT=20
F117_RANK_REPUTATION_WEIGHT=15
F117_RANK_MENTIONS_WEIGHT=15
F117_RANK_POPULARITY_WEIGHT=15
F117_RANK_GROWTH_WEIGHT=10
F117_RANK_NOVELTY_WEIGHT=10
F117_RANK_TOPIC_FIT_WEIGHT=10
F117_RANK_UNUSUALNESS_WEIGHT=5
F117_RANK_FRESHNESS_HALF_LIFE_HOURS=36
F117_RANK_FULL_MENTIONS=5

# M4 Discovery Engine: rule-based early signals, no GPT.
F117_DISCOVERY_GROWTH_WEIGHT=35
F117_DISCOVERY_ACCELERATION_WEIGHT=15
F117_DISCOVERY_DIVERSITY_WEIGHT=20
F117_DISCOVERY_NOVELTY_WEIGHT=15
F117_DISCOVERY_FRESHNESS_WEIGHT=15
F117_DISCOVERY_MIN_BASELINE=25
F117_DISCOVERY_MIN_GROWTH_ABSOLUTE=10
F117_DISCOVERY_RISING_THRESHOLD=55
F117_DISCOVERY_HIDDEN_GEM_MAX_POPULARITY=2000
F117_DISCOVERY_SELECTION_BOOST=0.2

# M5 Editorial diversity: soft caps; material above strong-score threshold is never deferred.
F117_DIVERSITY_MAX_PER_SOURCE=2
F117_DIVERSITY_MAX_PER_ENTITY=2
F117_DIVERSITY_MAX_PER_CATEGORY=4
F117_DIVERSITY_STRONG_SCORE_THRESHOLD=85

# Enable only when real API calls are intended. Never commit real keys.
F117_OPENAI_ENABLED=false
F117_OPENAI_API_KEY=
F117_OPENAI_MODEL=gpt-5.6-terra
F117_OPENAI_REASONING_EFFORT=low
F117_EDITORIAL_MAX_ATTEMPTS=3
F117_EDITORIAL_RETRY_BASE_SECONDS=60
F117_EDITORIAL_RETRY_MAX_SECONDS=3600
F117_EDITORIAL_RETRY_SLOTS=2

# The bot sends only to this one private chat. Never commit real credentials.
F117_TELEGRAM_ENABLED=false
F117_TELEGRAM_BOT_TOKEN=
F117_TELEGRAM_CHAT_ID=
F117_TELEGRAM_FEEDBACK_ENABLED=true
F117_TELEGRAM_FEEDBACK_POLL_SECONDS=10
F117_TELEGRAM_PACE_SECONDS=0.25
F117_DELIVERY_CLAIM_LEASE_SECONDS=300

# Dry-run prints the finished digest and does not mark items as delivered.
F117_DRY_RUN=true
F117_LOG_LEVEL=INFO
